# 仅供本地配置示例。真实密钥只放在 .env.local 或托管平台的服务端 Secret 中。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000

# 可替换的联网检索适配器；当前正式实现为 bocha。未配置时明确降级，不伪造结果。
WEB_SEARCH_PROVIDER=bocha
WEB_SEARCH_API_KEY=
# 兼容旧部署变量，可留空；优先读取 WEB_SEARCH_API_KEY。
BOCHA_API_KEY=

# 免费配额与匿名访问保护。
WEB_SEARCH_MAX_QUERIES=4
WEB_SEARCH_DAILY_LIMIT=200
REQUEST_LIMIT_WINDOW_MS=900000
REQUEST_LIMIT_MAX=10
