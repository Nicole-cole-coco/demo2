# 仅供本地配置示例。请勿把真实密钥提交到 Git。
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# DeepSeek 官方兼容接口。一般无需修改。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可按 DeepSeek 官方模型列表调整。
DEEPSEEK_MODEL=deepseek-v4-flash

# 单次请求超时，单位为毫秒。
DEEPSEEK_TIMEOUT_MS=45000

# 可选：联网搜索。用于门票、开放时间、美食、交通和预约资料。
# 未配置时网站仍能生成，但会明确显示“搜索待接入”。
BOCHA_API_KEY=replace_with_your_bocha_api_key

# 可选：高德 Web 服务 Key。用于 POI 匹配和相邻景点路线计算。
AMAP_WEB_SERVICE_KEY=replace_with_your_amap_web_service_key

# 费用保护：每次生成最多搜索 4 类资料、计算 12 段路线。
WEB_SEARCH_MAX_QUERIES=4
AMAP_MAX_ROUTE_LEGS=12
